# Default: treat all text files with automatic normalization
* text=auto

# Gradle wrapper scripts
/gradlew text eol=lf
/gradlew.bat text eol=crlf

# Shell scripts (LF only)
*.sh text eol=lf

# Windows batch files (CRLF only)
*.bat text eol=crlf

# Java source (LF is safe everywhere)
*.java text eol=lf

# Configuration files (LF is safe)
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf

# Binary files (no conversion)
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.svg binary
*.ico binary
